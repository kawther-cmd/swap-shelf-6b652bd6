{
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "vite.config.js",
    "vitest.config.js",
    "eslint.config.js",
    "route-tree-js-plugin.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
